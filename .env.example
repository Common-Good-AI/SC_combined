# ── GoVocal API ──────────────────────────────────────
GV_BASE_URL=https://YOURPLATFORM.govocal.com
GV_CLIENT_ID=YOUR_CLIENT_ID
GV_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Comma-separated GoVocal project UUIDs (2 surveys + 1 ideation)
GV_PROJECT_IDS=PROJECT_UUID_1,PROJECT_UUID_2,PROJECT_UUID_3

# ── Typeform API ─────────────────────────────────────
TF_TOKEN=YOUR_TYPEFORM_TOKEN
# Comma-separated Typeform form IDs
TF_FORM_IDS=FORM_ID_1,FORM_ID_2

# ── Google SSO Auth ──────────────────────────────────
# Flask session secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME

# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Comma-separated list of allowed email addresses (optional)
ALLOWED_EMAILS=alice@example.com,bob@example.com
# Comma-separated list of allowed email domains (optional)
ALLOWED_DOMAINS=example.com
# At least one of ALLOWED_EMAILS or ALLOWED_DOMAINS must be set

